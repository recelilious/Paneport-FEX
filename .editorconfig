# The settings of .clang-format, for editors. root = true keeps the settings of a repository
# that holds this one as a submodule, such as Paneport, from reaching these files.
root = true

[*.{c,cc,cpp,h,hpp,inl}]
indent_style = space
indent_size = 2
max_line_length = 140
